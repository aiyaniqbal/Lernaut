# ─── Lernaut Web Environment Variables ─────────────────────────────
# Required for server actions and Prisma database connection (Neon / Supabase)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Optional: Next.js Public URL
NEXT_PUBLIC_APP_URL="https://lernaut.vercel.app"

# ─── Authentication & Email Delivery (Better Auth + Gmail SMTP) ─────
BETTER_AUTH_SECRET="your-32-byte-hex-secret-generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"

# Gmail SMTP for Email OTP Delivery
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-gmail-app-password"
